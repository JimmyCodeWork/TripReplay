{
  "name": "tripreplay",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run license:check",
    "verify:clean": "docker build --file tools/ci/Dockerfile --progress plain --output type=cacheonly .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "pnpm --recursive --if-present run test",
    "license:check": "node tools/license-check/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
